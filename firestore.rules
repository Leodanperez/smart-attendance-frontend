rules_version = '2';

// Reglas compartidas por el panel web (Angular) y la app Android.
// Probar con Firebase Emulator Suite antes de desplegar.
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Helpers ----------
    function signedIn() { return request.auth != null; }
    function userDoc(uid) { return /databases/$(database)/documents/users/$(uid); }
    function me() { return get(userDoc(request.auth.uid)).data; }
    function isActive() {
      return signedIn() && exists(userDoc(request.auth.uid))
        && me().get('status', 'ACTIVE') == 'ACTIVE';
    }
    function hasRole(role) { return isActive() && me().role == role; }
    function isAdmin() { return hasRole('ADMIN'); }
    function isTeacher() { return hasRole('TEACHER'); }

    function courseData(courseId) { return get(/databases/$(database)/documents/courses/$(courseId)).data; }
    function teaches(courseId) { return isTeacher() && request.auth.uid in courseData(courseId).teacherIds; }
    function enrolledIn(courseId) {
      return isActive()
        && get(/databases/$(database)/documents/enrollments/$(courseId + '_' + request.auth.uid)).data.status == 'ACTIVE';
    }
    function changedKeys() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function sessionData(sessionId) { return get(/databases/$(database)/documents/sessions/$(sessionId)).data; }
    function tokenData(tokenId) { return get(/databases/$(database)/documents/sessionTokens/$(tokenId)).data; }
    // Modo demo sin Cloud Functions: el token del QR se valida con las reglas.
    function tokenValid(tokenId, sessionId) {
      let t = tokenData(tokenId);
      return t.status == 'ACTIVE' && t.sessionId == sessionId && t.expiresAt > request.time;
    }

    // ---------- users/{uid} ----------
    match /users/{uid} {
      // Lectura de perfiles: el propio usuario, ADMIN, o un docente sobre perfiles STUDENT/TEACHER
      // (para resolver nombres de alumnos/colegas). Un estudiante NO lee perfiles de docentes.
      allow get: if signedIn() && (
        request.auth.uid == uid
        || isAdmin()
        || (isTeacher() && resource.data.role in ['STUDENT', 'TEACHER'])
      );
      allow list: if isAdmin();

      // ADMIN registra usuarios desde el panel.
      // Alta propia desde Android: solo perfil STUDENT en estado PENDING.
      allow create: if isAdmin() || (
        signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'STUDENT'
        && request.resource.data.status == 'PENDING'
      );

      // ADMIN no puede cambiar su propio rol/estado. Cada usuario solo edita datos básicos propios.
      allow update: if (
          isAdmin() && (uid != request.auth.uid || !changedKeys().hasAny(['role', 'status', 'uid']))
        ) || (
          request.auth.uid == uid
          && changedKeys().hasOnly(['firstName', 'lastName', 'displayName', 'phone', 'address', 'photoUrl', 'updatedAt'])
        );
      allow delete: if false;
    }

    // ---------- courses/{courseId} ----------
    match /courses/{courseId} {
      allow get: if isAdmin()
        || (isTeacher() && request.auth.uid in resource.data.teacherIds)
        || enrolledIn(courseId);
      allow list: if isAdmin() || (isTeacher() && request.auth.uid in resource.data.teacherIds);
      allow create, update: if isAdmin();
      allow delete: if false;
    }

    // ---------- enrollments/{courseId_studentId} ----------
    function codeData(codeId) { return get(/databases/$(database)/documents/enrollmentCodes/$(codeId)).data; }
    // Modo demo sin Cloud Functions: un código de inscripción es válido si está ACTIVE, vigente y con cupo.
    function enrollmentCodeValid(codeId, courseId) {
      let c = codeData(codeId);
      return c.status == 'ACTIVE' && c.courseId == courseId && c.expiresAt > request.time && c.uses < c.maxUses;
    }

    match /enrollments/{enrollmentId} {
      allow read: if isAdmin()
        || teaches(resource.data.courseId)
        || (signedIn() && resource.data.studentId == request.auth.uid);

      // ADMIN inscribe manualmente desde el panel.
      allow create: if isAdmin()
        && enrollmentId == request.resource.data.courseId + '_' + request.resource.data.studentId;

      // Autoinscripción del estudiante con un código válido (modo demo, sin Cloud Functions).
      // El id es determinístico (courseId_uid), status ACTIVE, source CODE, y el código referido
      // debe estar ACTIVE, vigente, con cupo y pertenecer al mismo curso.
      allow create: if isActive()
        && request.resource.data.studentId == request.auth.uid
        && enrollmentId == request.resource.data.courseId + '_' + request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.source == 'CODE'
        && request.resource.data.enrolledBy == request.auth.uid
        && request.resource.data.codeId is string
        && enrollmentCodeValid(request.resource.data.codeId, request.resource.data.courseId);

      allow update: if isAdmin()
        && enrollmentId == request.resource.data.courseId + '_' + request.resource.data.studentId;
      allow delete: if false;
    }

    // ---------- enrollmentCodes/{codeId} ----------
    match /enrollmentCodes/{codeId} {
      // Lectura: ADMIN, o un usuario activo que busca por codeHash para canjear (solo metadatos + hash).
      allow read: if isAdmin() || isActive();
      allow create: if isAdmin()
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.uses == 0
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.codeHash is string
        && request.resource.data.codeHash.size() == 64;
      // ADMIN deshabilita el código.
      allow update: if isAdmin()
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'DISABLED';
      // El estudiante que canjea incrementa 'uses' en 1 (sin exceder el cupo), con el código vigente.
      allow update: if isActive()
        && changedKeys().hasOnly(['uses'])
        && resource.data.status == 'ACTIVE'
        && resource.data.expiresAt > request.time
        && request.resource.data.uses == resource.data.uses + 1
        && request.resource.data.uses <= resource.data.maxUses;
      allow delete: if false;
    }

    // ---------- sessions/{sessionId} ----------
    match /sessions/{sessionId} {
      allow read: if isAdmin()
        || teaches(resource.data.courseId)
        || enrolledIn(resource.data.courseId);
      allow create: if (isAdmin() || teaches(request.resource.data.courseId))
        && request.resource.data.teacherId == request.auth.uid
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.expiresAt > request.resource.data.startsAt;
      allow update: if (isAdmin() || teaches(resource.data.courseId))
        && changedKeys().hasOnly(['status', 'closedAt'])
        && request.resource.data.status == 'CLOSED';
      allow delete: if false;
    }

    // ---------- sessionTokens/{tokenId} ----------
    // Modo demo: el docente genera el token del QR desde el panel. El estudiante inscrito solo
    // puede LEER el token vigente (para validarlo al marcar asistencia), nunca su contenido sensible
    // más allá de lo necesario. El token en claro nunca se guarda, solo su hash.
    match /sessionTokens/{tokenId} {
      allow get: if isActive();
      allow list: if isAdmin() || teaches(resource.data.courseId);
      allow create: if (isAdmin() || teaches(request.resource.data.courseId))
        && request.resource.data.status == 'ACTIVE'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.sessionId is string
        && request.resource.data.tokenHash is string
        && request.resource.data.expiresAt is timestamp;
      // Solo revocar (al rotar o cerrar la sesión).
      allow update: if (isAdmin() || teaches(resource.data.courseId))
        && changedKeys().hasOnly(['status'])
        && request.resource.data.status == 'REVOKED';
      allow delete: if false;
    }

    // ---------- attendances/{sessionId_studentId} ----------
    match /attendances/{attendanceId} {
      allow read: if isAdmin()
        || teaches(resource.data.courseId)
        || (signedIn() && resource.data.studentId == request.auth.uid);

      // Registro por QR (modo demo, sin Cloud Functions): el propio estudiante crea SU asistencia.
      // Requisitos: id determinístico, está inscrito, la sesión está ACTIVE y en horario,
      // el token del QR es válido, no existe registro previo, source=QR y no se tocan campos de corrección.
      allow create: if isActive()
        && request.resource.data.studentId == request.auth.uid
        && attendanceId == request.resource.data.sessionId + '_' + request.auth.uid
        && request.resource.data.source == 'QR'
        && request.resource.data.status in ['PRESENT', 'LATE']
        && request.resource.data.registeredAt == request.time
        && enrolledIn(request.resource.data.courseId)
        && sessionData(request.resource.data.sessionId).courseId == request.resource.data.courseId
        && sessionData(request.resource.data.sessionId).status == 'ACTIVE'
        && sessionData(request.resource.data.sessionId).startsAt <= request.time
        && sessionData(request.resource.data.sessionId).expiresAt >= request.time
        && tokenValid(request.resource.data.tokenId, request.resource.data.sessionId);

      // Corrección manual con motivo (docente del curso o ADMIN).
      allow update: if (isAdmin() || teaches(request.resource.data.courseId))
        && attendanceId == request.resource.data.sessionId + '_' + request.resource.data.studentId
        && sessionData(request.resource.data.sessionId).courseId == request.resource.data.courseId
        && request.resource.data.status in ['PRESENT', 'LATE', 'ABSENT', 'JUSTIFIED']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updateReason is string
        && request.resource.data.updateReason.size() > 0
        && resource.data.courseId == request.resource.data.courseId
        && resource.data.sessionId == request.resource.data.sessionId
        && resource.data.studentId == request.resource.data.studentId;

      // Corrección que crea el registro faltante (marcar a alguien sin asistencia).
      allow create: if (isAdmin() || teaches(request.resource.data.courseId))
        && attendanceId == request.resource.data.sessionId + '_' + request.resource.data.studentId
        && sessionData(request.resource.data.sessionId).courseId == request.resource.data.courseId
        && request.resource.data.status in ['PRESENT', 'LATE', 'ABSENT', 'JUSTIFIED']
        && request.resource.data.updatedBy == request.auth.uid
        && request.resource.data.updateReason is string
        && request.resource.data.updateReason.size() > 0;

      allow delete: if false;
    }

    // ---------- auditLogs/{logId}: solo se crean, nunca se editan ni borran ----------
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isActive()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }

    // ---------- academicPeriods/{periodId}: ID = nombre (2026-I, 2026-II) ----------
    match /academicPeriods/{periodId} {
      allow read: if isActive();
      allow create: if isAdmin()
        && periodId.matches('^[0-9]{4}-(I|II)$')
        && request.resource.data.name == periodId
        && request.resource.data.status == 'PLANNED'
        && request.resource.data.endsOn > request.resource.data.startsOn;
      allow update: if isAdmin()
        && request.resource.data.name == resource.data.name
        && request.resource.data.year == resource.data.year
        && request.resource.data.term == resource.data.term
        && request.resource.data.status in ['PLANNED', 'ACTIVE', 'CLOSED']
        && request.resource.data.endsOn > request.resource.data.startsOn;
      allow delete: if false;
    }

    // ---------- careers/{careerId} ----------
    // Catálogo de carreras: lo leen usuarios activos; solo ADMIN lo administra. No se borra.
    match /careers/{careerId} {
      allow read: if isActive();
      allow create, update: if isAdmin()
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.durationSemesters is int
        && request.resource.data.durationSemesters >= 1
        && request.resource.data.durationSemesters <= 12
        && request.resource.data.status in ['ACTIVE', 'INACTIVE']
        && (resource == null || request.resource.data.code == resource.data.code);
      allow delete: if false;
    }

    // ---------- settings/{docId} ----------
    match /settings/{docId} {
      allow read: if isActive();
      allow write: if isAdmin();
    }
  }
}
