  "cloudFunctions": {
    "redeemEnrollmentCode": {
      "type": "callable",
      "input": {
        "code": "string"
      },
      "output": {
        "courseId": "string",
        "courseName": "string"
      },
      "validates": [
        "usuario ACTIVE y STUDENT",
        "hash del código",
        "status ACTIVE",
        "no vencido",
        "uses < maxUses",
        "curso ACTIVE",
        "no inscrito ya"
      ],
      "writes": [
        "enrollments/{courseId}_{uid}",
        "enrollmentCodes.uses (+1, transacción)",
        "courses.enrollmentCount (+1)",
        "auditLogs"
      ]
    },
    "generateSessionToken": {
      "type": "callable",
      "input": {
        "sessionId": "string"
      },
      "output": {
        "token": "string",
        "expiresAt": "number (epoch ms)"
      },
      "validates": [
        "usuario ACTIVE",
        "docente asignado al curso o ADMIN",
        "sesión ACTIVE y no vencida"
      ],
      "writes": [
        "sessionTokens (nuevo, ACTIVE)",
        "sessionTokens anteriores de la sesión -> REVOKED"
      ]
    },
    "registerAttendance": {
      "type": "callable",
      "input": {
        "token": "string"
      },
      "output": {
        "status": "PRESENT|LATE",
        "courseName": "string",
        "sessionTitle": "string",
        "registeredAt": "number (epoch ms)"
      },
      "validates": [
        "usuario ACTIVE y STUDENT",
        "hash del token ACTIVE y no vencido",
        "sesión ACTIVE y dentro de horario",
        "inscripción ACTIVE",
        "no existe attendances/{sessionId}_{uid}"
      ],
      "writes": [
        "attendances/{sessionId}_{uid} (transacción, create-only)",
        "sessions.stats (+1 present/late)"
      ],
      "errors": [
        "TOKEN_EXPIRED",
        "SESSION_CLOSED",
        "NOT_ENROLLED",
        "ALREADY_REGISTERED",
        "USER_NOT_ACTIVE"
      ]
    },
    "onSessionClosed": {
      "type": "firestore trigger (sessions/{sessionId} status ACTIVE -> CLOSED)",
      "writes": [
        "sessionTokens -> REVOKED",
        "attendances ABSENT (source=SYSTEM) para inscritos sin registro",
        "sessions.stats"
      ]
    },
    "onEnrollmentWrite": {
      "type": "firestore trigger (enrollments/{id})",
      "writes": [
        "courses.enrollmentCount"
      ]
    }
  },
