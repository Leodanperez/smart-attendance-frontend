{
  "name": "SmartAttendance - Modelo de datos Cloud Firestore",
  "version": "1.2.0",
  "basedOn": [
    "01-diseno-pantallas-android.md",
    "02-arquitectura-app-y-firebase.md",
    "03-panel-angular-administracion.md",
    "04-flujo-y-resultado-semana-tecnica.md"
  ],
  "conventions": {
    "naming": "Colecciones en camelCase plural y campos en camelCase, en inglés. Valores de enums en MAYÚSCULAS.",
    "topLevelCollections": "Todas las colecciones son top-level para facilitar consultas y reglas explícitas (02 §6).",
    "ids": {
      "users": "UID de Firebase Authentication",
      "enrollments": "courseId_studentId (determinístico, evita duplicados)",
      "attendances": "sessionId_studentId (determinístico, una asistencia por estudiante y sesión)",
      "others": "ID automático de Firestore",
      "academicPeriods": "Nombre del periodo: 2026-I, 2026-II (evita duplicados)"
    },
    "timestamps": "Toda fecha crítica es Timestamp generado en servidor (serverTimestamp / hora de la Cloud Function). Nunca la hora del teléfono.",
    "nulls": "Los campos opcionales se guardan como null (no se omiten) para que Android y Angular lean la misma forma.",
    "denormalization": "Campos marcados con denormalized=true son copias para mostrar sin joins (p. ej. el nombre del estudiante en la lista en vivo). Los escribe la Cloud Function o la operación que crea el documento; la fuente de verdad sigue siendo la colección original.",
    "secrets": "Nunca se guardan contraseñas, códigos de inscripción ni tokens QR en texto plano: solo su hash SHA-256 (hex, 64 caracteres)."
  },
  "enums": {
    "UserRole": [
      "STUDENT",
      "TEACHER",
      "ADMIN"
    ],
    "UserStatus": [
      "PENDING",
      "ACTIVE",
      "DISABLED"
    ],
    "AuthProvider": [
      "password",
      "google.com"
    ],
    "DocumentType": [
      "DNI",
      "CE",
      "PASSPORT"
    ],
    "Gender": [
      "MALE",
      "FEMALE",
      "OTHER"
    ],
    "AcademicPeriodStatus": [
      "PLANNED",
      "ACTIVE",
      "CLOSED"
    ],
    "CourseStatus": [
      "ACTIVE",
      "INACTIVE"
    ],
    "EnrollmentStatus": [
      "ACTIVE",
      "DROPPED"
    ],
    "EnrollmentSource": [
      "CODE",
      "ADMIN"
    ],
    "EnrollmentCodeStatus": [
      "ACTIVE",
      "DISABLED"
    ],
    "SessionStatus": [
      "ACTIVE",
      "CLOSED"
    ],
    "SessionTokenStatus": [
      "ACTIVE",
      "REVOKED"
    ],
    "AttendanceStatus": [
      "PRESENT",
      "LATE",
      "ABSENT",
      "JUSTIFIED"
    ],
    "AttendanceSource": [
      "QR",
      "MANUAL",
      "SYSTEM"
    ],
    "AuditEntityType": [
      "USER",
      "CAREER",
      "PERIOD",
      "COURSE",
      "ENROLLMENT",
      "ENROLLMENT_CODE",
      "SESSION",
      "ATTENDANCE",
      "SETTINGS"
    ],
    "AuditAction": [
      "USER_CREATED",
      "USER_UPDATED",
      "USER_STATUS_CHANGED",
      "USER_ROLE_CHANGED",
      "PERIOD_CLOSED",
      "PERIOD_ACTIVATED",
      "PERIOD_UPDATED",
      "PERIOD_CREATED",
      "CAREER_STATUS_CHANGED",
      "CAREER_UPDATED",
      "CAREER_CREATED",
      "COURSE_CREATED",
      "COURSE_UPDATED",
      "COURSE_STATUS_CHANGED",
      "TEACHER_ASSIGNED",
      "TEACHER_REMOVED",
      "ENROLLMENT_CREATED",
      "ENROLLMENT_DROPPED",
      "ENROLLMENT_CODE_CREATED",
      "ENROLLMENT_CODE_DISABLED",
      "SESSION_CREATED",
      "SESSION_CLOSED",
      "ATTENDANCE_MANUALLY_UPDATED",
      "SETTINGS_UPDATED"
    ],
    "CareerStatus": [
      "ACTIVE",
      "INACTIVE"
    ],
    "PeriodTerm": [
      1,
      2
    ]
  },
  "collections": {
    "users": {
      "path": "users/{uid}",
      "description": "Perfil institucional. Uno por identidad de Firebase Authentication.",
      "writtenBy": [
        "Android: alta propia con role=STUDENT y status=PENDING",
        "Angular (ADMIN): alta, datos institucionales, rol y estado",
        "El propio usuario: solo firstName, lastName, displayName, phone, address, photoUrl"
      ],
      "fields": {
        "uid": {
          "type": "string",
          "required": true,
          "description": "Igual al ID del documento y al UID de Auth"
        },
        "firstName": {
          "type": "string",
          "required": true
        },
        "lastName": {
          "type": "string",
          "required": true
        },
        "displayName": {
          "type": "string",
          "required": true,
          "description": "firstName + ' ' + lastName"
        },
        "email": {
          "type": "string",
          "required": true,
          "description": "En minúsculas"
        },
        "photoUrl": {
          "type": "string|null",
          "required": true,
          "description": "URL de Storage: profilePhotos/{uid}/avatar"
        },
        "institutionalCode": {
          "type": "string|null",
          "required": true,
          "description": "Generado: STU-/TEA-/ADM- + documentNumber. Ej: STU-12345678. Cambia de prefijo si cambia el rol."
        },
        "documentType": {
          "type": "DocumentType|null",
          "required": true
        },
        "documentNumber": {
          "type": "string|null",
          "required": true,
          "description": "Único. DNI = 8 dígitos"
        },
        "birthDate": {
          "type": "string|null",
          "required": true,
          "description": "Formato YYYY-MM-DD (sin zona horaria)"
        },
        "gender": {
          "type": "Gender|null",
          "required": true
        },
        "phone": {
          "type": "string|null",
          "required": true,
          "description": "9 dígitos, empieza con 9"
        },
        "address": {
          "type": "string|null",
          "required": true
        },
        "role": {
          "type": "UserRole",
          "required": true,
          "description": "Solo lo modifica un ADMIN. Nunca el propio usuario."
        },
        "status": {
          "type": "UserStatus",
          "required": true,
          "description": "PENDING hasta validación institucional. Solo ACTIVE puede operar."
        },
        "authProvider": {
          "type": "AuthProvider",
          "required": true
        },
        "profileCompleted": {
          "type": "boolean",
          "required": true,
          "description": "false => Android muestra A05 Completar perfil"
        },
        "createdBy": {
          "type": "string|null",
          "required": true,
          "description": "UID del ADMIN que lo registró; null si fue alta propia"
        },
        "createdAt": {
          "type": "timestamp",
          "required": true
        },
        "updatedAt": {
          "type": "timestamp",
          "required": true
        }
      },
      "example": {
        "uid": "uid-estudiante-01",
        "firstName": "Ana",
        "lastName": "López",
        "displayName": "Ana López",
        "email": "ana.lopez@example.edu.pe",
        "photoUrl": null,
        "institutionalCode": "STU-00000001",
        "documentType": "DNI",
        "documentNumber": "00000001",
        "birthDate": "2005-04-12",
        "gender": "FEMALE",
        "phone": "900000001",
        "address": null,
        "role": "STUDENT",
        "status": "ACTIVE",
        "authProvider": "password",
        "profileCompleted": true,
        "createdBy": "uid-admin-01",
        "createdAt": "SERVER_TIMESTAMP",
        "updatedAt": "SERVER_TIMESTAMP"
      }
    },
    "academicPeriods": {
      "path": "academicPeriods/{periodId}",
      "description": "Periodo académico (calendario). Dos por año: I = marzo–julio, II = agosto–diciembre. El ID es el nombre. Solo uno ACTIVE a la vez. Distinto del ciclo (nivel de la carrera).",
      "writtenBy": [
        "Angular (ADMIN)"
      ],
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Igual al ID: 2026-I / 2026-II"
        },
        "year": {
          "type": "number",
          "required": true
        },
        "term": {
          "type": "PeriodTerm",
          "required": true,
          "description": "1 = I, 2 = II"
        },
        "startsOn": {
          "type": "string",
          "required": true,
          "description": "YYYY-MM-DD"
        },
        "endsOn": {
          "type": "string",
          "required": true,
          "description": "YYYY-MM-DD, posterior a startsOn"
        },
        "status": {
          "type": "AcademicPeriodStatus",
          "required": true,
          "description": "PLANNED → ACTIVE (en curso; cierra el anterior) → CLOSED (sus cursos pasan a INACTIVE; las asistencias se conservan)"
        },
        "createdBy": {
          "type": "string",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "required": true
        },
        "updatedAt": {
          "type": "timestamp",
          "required": true
        }
      },
      "example": {
        "name": "2026-II",
        "year": 2026,
        "term": 2,
        "startsOn": "2026-08-01",
        "endsOn": "2026-12-20",
        "status": "ACTIVE",
        "createdBy": "uid-admin-01",
        "createdAt": "SERVER_TIMESTAMP",
        "updatedAt": "SERVER_TIMESTAMP"
      }
    },
    "careers": {
      "path": "careers/{careerId}",
      "description": "Carrera profesional del instituto. Cada curso pertenece a una carrera y a un semestre.",
      "writtenBy": [
        "Angular (ADMIN)"
      ],
      "fields": {
        "name": {
          "type": "string",
          "required": true,
          "description": "Único. Ej: Desarrollo de Sistemas de Información"
        },
        "code": {
          "type": "string",
          "required": true,
          "description": "Generado de las iniciales del nombre, único (DSI, DSI2…). No cambia."
        },
        "description": {
          "type": "string",
          "required": true,
          "description": "Puede ser cadena vacía"
        },
        "durationSemesters": {
          "type": "number",
          "required": true,
          "description": "Número de ciclos, entero 1..12. Técnica: 6 ciclos (3 años)"
        },
        "status": {
          "type": "CareerStatus",
          "required": true,
          "description": "INACTIVE: no se elige en cursos nuevos; los cursos existentes no cambian"
        },
        "createdBy": {
          "type": "string",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "required": true
        },
        "updatedAt": {
          "type": "timestamp",
          "required": true
        }
      },
      "example": {
        "name": "Desarrollo de Sistemas de Información",
        "code": "DSI",
        "description": "Formación técnica en análisis, desarrollo y mantenimiento de software",
        "durationSemesters": 6,
        "status": "ACTIVE",
        "createdBy": "uid-admin-01",
        "createdAt": "SERVER_TIMESTAMP",
        "updatedAt": "SERVER_TIMESTAMP"
      }
    },
    "courses": {
      "path": "courses/{courseId}",
      "description": "Oferta de un curso: carrera + ciclo + periodo académico + sección. Cada periodo tiene sus propios documentos de curso; los de periodos cerrados quedan como historial.",
      "writtenBy": [
        "Angular (ADMIN)",
        "Cloud Functions (contador enrollmentCount)"
      ],
      "fields": {
        "name": {
          "type": "string",
          "required": true
        },
        "description": {
          "type": "string",
          "required": true,
          "description": "Puede ser cadena vacía"
        },
        "courseCode": {
          "type": "string",
          "required": true,
          "description": "Generado al crear: INICIALES-AÑO-NNNN (aleatorio, único). Ej: IGS-2026-4821. No cambia al editar."
        },
        "academicPeriodId": {
          "type": "string",
          "required": true,
          "description": "Ref. a academicPeriods (p. ej. 2026-II)"
        },
        "academicPeriodName": {
          "type": "string",
          "required": true,
          "denormalized": true,
          "description": "Copia: 2026-II"
        },
        "careerId": {
          "type": "string",
          "required": true,
          "description": "Ref. a careers"
        },
        "careerName": {
          "type": "string",
          "required": true,
          "denormalized": true,
          "description": "Copia del nombre de la carrera; se actualiza al renombrarla"
        },
        "semester": {
          "type": "number",
          "required": true,
          "description": "Ciclo de la carrera (nivel del plan de estudios): 1..careers.durationSemesters. En la interfaz se muestra como \"V ciclo\"."
        },
        "section": {
          "type": "string",
          "required": true,
          "description": "Ej: A"
        },
        "schedule": {
          "type": "array<ScheduleBlock>",
          "required": false,
          "description": "Horario semanal del curso. Cada bloque = { day: 'MON'|'TUE'|'WED'|'THU'|'FRI'|'SAT'|'SUN', start: 'HH:mm', end: 'HH:mm' }. Puede estar vacío."
        },
        "teacherIds": {
          "type": "array<string>",
          "required": true,
          "description": "UIDs de docentes asignados. Base de la regla 'el docente solo ve sus cursos'."
        },
        "enrollmentCount": {
          "type": "number",
          "required": true,
          "denormalized": true,
          "description": "Inscripciones ACTIVE. Lo mantiene una Cloud Function."
        },
        "status": {
          "type": "CourseStatus",
          "required": true
        },
        "createdBy": {
          "type": "string",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "required": true
        },
        "updatedAt": {
          "type": "timestamp",
          "required": true
        }
      },
      "example": {
        "name": "Desarrollo de Sistemas",
        "description": "Curso de desarrollo de aplicaciones",
        "courseCode": "DSS-2026-4821",
        "academicPeriodId": "2026-II",
        "academicPeriodName": "2026-II",
        "careerId": "career-dsi",
        "careerName": "Desarrollo de Sistemas de Información",
        "semester": 6,
        "section": "A",
        "schedule": [
          { "day": "MON", "start": "08:00", "end": "10:00" },
          { "day": "WED", "start": "10:00", "end": "12:00" }
        ],
        "teacherIds": [
          "uid-docente-01"
        ],
        "enrollmentCount": 12,
        "status": "ACTIVE",
        "createdBy": "uid-admin-01",
        "createdAt": "SERVER_TIMESTAMP",
        "updatedAt": "SERVER_TIMESTAMP"
      }
    },
    "enrollments": {
      "path": "enrollments/{courseId}_{studentId}",
      "description": "Matrícula de un estudiante en un curso. ID determinístico para impedir duplicados.",
      "writtenBy": [
        "Cloud Function redeemEnrollmentCode (estudiante con código)",
        "Angular (ADMIN): inscripción manual y retiro"
      ],
      "fields": {
        "courseId": {
          "type": "string",
          "required": true
        },
        "studentId": {
          "type": "string",
          "required": true
        },
        "studentName": {
          "type": "string",
          "required": true,
          "denormalized": true,
          "description": "Para listas del docente sin leer users"
        },
        "studentCode": {
          "type": "string|null",
          "required": true,
          "denormalized": true,
          "description": "institutionalCode del estudiante"
        },
        "status": {
          "type": "EnrollmentStatus",
          "required": true
        },
        "source": {
          "type": "EnrollmentSource",
          "required": true
        },
        "enrollmentCodeId": {
          "type": "string|null",
          "required": true,
          "description": "Código usado, si source=CODE"
        },
        "enrolledAt": {
          "type": "timestamp",
          "required": true
        },
        "enrolledBy": {
          "type": "string",
          "required": true,
          "description": "UID del estudiante (CODE) o del ADMIN"
        },
        "droppedAt": {
          "type": "timestamp|null",
          "required": true
        },
        "droppedReason": {
          "type": "string|null",
          "required": true
        }
      },
      "example": {
        "courseId": "course-ds-01",
        "studentId": "uid-estudiante-01",
        "studentName": "Ana López",
        "studentCode": "STU-00000001",
        "status": "ACTIVE",
        "source": "CODE",
        "enrollmentCodeId": "code-01",
        "enrolledAt": "SERVER_TIMESTAMP",
        "enrolledBy": "uid-estudiante-01",
        "droppedAt": null,
        "droppedReason": null
      }
    },
    "enrollmentCodes": {
      "path": "enrollmentCodes/{codeId}",
      "description": "Código para que el estudiante se una a un curso (A08). Solo se guarda el hash; el código se muestra una vez al generarlo.",
      "writtenBy": [
        "Angular (ADMIN): crear y desactivar",
        "Cloud Function redeemEnrollmentCode: uses, lastUsedAt"
      ],
      "fields": {
        "courseId": {
          "type": "string",
          "required": true
        },
        "codeHash": {
          "type": "string",
          "required": true,
          "description": "SHA-256 hex del código en MAYÚSCULAS"
        },
        "status": {
          "type": "EnrollmentCodeStatus",
          "required": true
        },
        "expiresAt": {
          "type": "timestamp",
          "required": true
        },
        "maxUses": {
          "type": "number",
          "required": true
        },
        "uses": {
          "type": "number",
          "required": true,
          "description": "Lo incrementa solo la Cloud Function en una transacción"
        },
        "lastUsedAt": {
          "type": "timestamp|null",
          "required": true
        },
        "createdBy": {
          "type": "string",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "required": true
        }
      },
      "example": {
        "courseId": "course-ds-01",
        "codeHash": "9f2c...64-hex-chars",
        "status": "ACTIVE",
        "expiresAt": "SERVER_TIMESTAMP_PLUS_7_DAYS",
        "maxUses": 40,
        "uses": 12,
        "lastUsedAt": "SERVER_TIMESTAMP",
        "createdBy": "uid-admin-01",
        "createdAt": "SERVER_TIMESTAMP"
      }
    },
    "sessions": {
      "path": "sessions/{sessionId}",
      "description": "Sesión de clase con asistencia. Solo con status=ACTIVE y dentro de startsAt..expiresAt se acepta el QR.",
      "writtenBy": [
        "Angular / Android (docente del curso o ADMIN)",
        "Cloud Functions: contadores stats"
      ],
      "fields": {
        "courseId": {
          "type": "string",
          "required": true
        },
        "courseName": {
          "type": "string",
          "required": true,
          "denormalized": true
        },
        "courseCode": {
          "type": "string",
          "required": true,
          "denormalized": true
        },
        "title": {
          "type": "string",
          "required": true
        },
        "teacherId": {
          "type": "string",
          "required": true,
          "description": "Docente que creó la sesión"
        },
        "teacherName": {
          "type": "string",
          "required": true,
          "denormalized": true
        },
        "status": {
          "type": "SessionStatus",
          "required": true
        },
        "startsAt": {
          "type": "timestamp",
          "required": true
        },
        "expiresAt": {
          "type": "timestamp",
          "required": true,
          "description": "startsAt + duración"
        },
        "durationMinutes": {
          "type": "number",
          "required": true
        },
        "lateAfter": {
          "type": "timestamp|null",
          "required": true,
          "description": "Desde esta hora el registro QR queda como LATE. null = sin tardanza"
        },
        "stats": {
          "type": "map",
          "required": true,
          "denormalized": true,
          "description": "Contadores en vivo para el proyector (04 §3). Los actualiza registerAttendance en la misma transacción.",
          "fields": {
            "enrolled": {
              "type": "number"
            },
            "present": {
              "type": "number"
            },
            "late": {
              "type": "number"
            },
            "absent": {
              "type": "number"
            },
            "justified": {
              "type": "number"
            }
          }
        },
        "createdAt": {
          "type": "timestamp",
          "required": true
        },
        "closedAt": {
          "type": "timestamp|null",
          "required": true
        },
        "closedBy": {
          "type": "string|null",
          "required": true
        }
      },
      "example": {
        "courseId": "course-ds-01",
        "courseName": "Desarrollo de Sistemas",
        "courseCode": "DSS-2026-4821",
        "title": "Demostración Semana Técnica",
        "teacherId": "uid-docente-01",
        "teacherName": "Carlos Ramírez",
        "status": "ACTIVE",
        "startsAt": "2026-11-20T10:00:00-05:00",
        "expiresAt": "2026-11-20T11:30:00-05:00",
        "durationMinutes": 90,
        "lateAfter": "2026-11-20T10:15:00-05:00",
        "stats": {
          "enrolled": 12,
          "present": 8,
          "late": 1,
          "absent": 0,
          "justified": 0
        },
        "createdAt": "SERVER_TIMESTAMP",
        "closedAt": null,
        "closedBy": null
      }
    },
    "sessionTokens": {
      "path": "sessionTokens/{tokenId}",
      "description": "Token opaco y temporal que va dentro del QR (A16). Sin datos personales. Se rota cada ~60 s. Ningún cliente lo lee ni escribe.",
      "writtenBy": [
        "Solo Cloud Function generateSessionToken"
      ],
      "fields": {
        "sessionId": {
          "type": "string",
          "required": true
        },
        "courseId": {
          "type": "string",
          "required": true
        },
        "tokenHash": {
          "type": "string",
          "required": true,
          "description": "SHA-256 hex del token. El token en claro solo viaja al docente."
        },
        "status": {
          "type": "SessionTokenStatus",
          "required": true,
          "description": "REVOKED al rotar o al cerrar la sesión"
        },
        "expiresAt": {
          "type": "timestamp",
          "required": true,
          "description": "createdAt + 60 s (configurable en settings)"
        },
        "createdBy": {
          "type": "string",
          "required": true
        },
        "createdAt": {
          "type": "timestamp",
          "required": true
        }
      },
      "example": {
        "sessionId": "session-001",
        "courseId": "course-ds-01",
        "tokenHash": "4ab1...64-hex-chars",
        "status": "ACTIVE",
        "expiresAt": "SERVER_TIMESTAMP_PLUS_60_SECONDS",
        "createdBy": "uid-docente-01",
        "createdAt": "SERVER_TIMESTAMP"
      }
    },
    "attendances": {
      "path": "attendances/{sessionId}_{studentId}",
      "description": "Una asistencia por estudiante y sesión. El panel la escucha en tiempo real.",
      "writtenBy": [
        "Cloud Function registerAttendance (source=QR)",
        "Cloud Function closeSession (source=SYSTEM, ABSENT para inscritos sin registro)",
        "Docente del curso / ADMIN: corrección con motivo (source se conserva, updatedBy + updateReason)"
      ],
      "fields": {
        "sessionId": {
          "type": "string",
          "required": true
        },
        "courseId": {
          "type": "string",
          "required": true,
